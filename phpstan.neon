includes:
    # the extensions of the bundle itself: phpstan/extension-installer only registers those of the dependencies
    - extension.neon
    - shipmonk.neon

parameters:
    level: max
    paths:
        - config/rector
        - src
        - tests
    tmpDir: var/tools/phpstan
    excludePaths:
        # read by GrantsMethodExtensionTest, which expects one of them to be reported
        - tests/PHPStan/Data/*
    ignoreErrors:
        # the voters RuleLoaderTest builds are invalid on purpose: the loader must refuse them
        -
            identifiers:
                - argument.type
                - class.notFound
                - missingType.parameter
                - missingType.return
                - return.unusedType
            path: tests/Rule/RuleLoaderTest.php
        # the rule the extension feeds is internal to PHPStan: a minor version may change it, the test would tell
        -
            identifier: phpstanApi.classConstant
            path: tests/PHPStan/GrantsMethodExtensionTest.php
            count: 1
        # Rector's container builds the rules
        -
            identifier: shipmonk.deadMethod
            message: '#^Unused Silarhi\\VoterBundle\\Rector\\GrantsAware\w+::__construct$#'
            path: src/Rector
            count: 2
        # Symfony 8 no longer declares it on UserInterface; 7.4 still does, so it is not reported there
        -
            identifier: shipmonk.deadMethod
            path: tests/Fixtures/Model/User.php
            reportUnmatched: false
